from __future__ import annotations

import json
import logging
import re
from datetime import datetime
from pathlib import Path
from typing import Any

from toutiao_content_factory.config import AppSettings

try:
    from playwright.sync_api import TimeoutError as PlaywrightTimeoutError
    from playwright.sync_api import sync_playwright
except ModuleNotFoundError:  # pragma: no cover - optional dependency fallback
    PlaywrightTimeoutError = Exception
    sync_playwright = None


class DouyinPublishService:
    DEFAULT_CAPTION_SELECTORS = [
        "textarea[placeholder*='??']",
        "textarea[placeholder*='??????']",
        "div[contenteditable='true']",
    ]
    DEFAULT_UPLOAD_SELECTORS = [
        "input[type='file'][accept*='image']",
        "input[type='file']",
    ]
    DEFAULT_PUBLISH_SELECTORS = [
        "button:has-text('??')",
        "button:has-text('????')",
        "div[role='button']:has-text('??')",
    ]
    DEFAULT_SUCCESS_SELECTORS = [
        "text=????",
        "text=???",
        "text=????",
        "text=???",
    ]

    def __init__(self, settings: AppSettings, logger: logging.Logger) -> None:
        self.settings = settings
        self.logger = logger
        self.history_path = settings.output_dir / settings.douyin.history_filename

    def prepare_run(self, run_dir: Path) -> dict[str, Path]:
        publish_dir = run_dir / self.settings.review.publish_dirname
        if not publish_dir.exists():
            raise FileNotFoundError(f"Publish package not found: {publish_dir}")

        publish_meta = self._load_json(publish_dir / "publish_meta.json")
        title = self._clip_title(str(publish_meta.get("selected_title", "")).strip() or run_dir.name)
        summary = str(publish_meta.get("summary", "")).strip()
        article = self._read_text(publish_dir / "article.md").strip()
        cover_path, image_paths = self._resolve_image_assets(publish_dir)
        caption = self._build_caption(title=title, summary=summary, article=article)
        hashtags = self._build_hashtags(title=title, summary=summary, article=article)
        notes = self._build_notes(title=title, caption=caption, hashtags=hashtags)

        douyin_dir = publish_dir / "douyin"
        douyin_dir.mkdir(parents=True, exist_ok=True)
        payload = {
            "generated_at": self._now(),
            "platform": "douyin",
            "account_key": self.settings.account_key,
            "niche": self.settings.douyin.niche,
            "publish_mode": self.settings.douyin.publish_mode,
            "daily_post_target": int(self.settings.douyin.daily_post_target),
            "title": title,
            "caption": caption,
            "hashtags": hashtags,
            "notes": notes,
            "image_paths": [str(path) for path in image_paths],
            "cover_path": str(cover_path),
            "source_run_dir": str(run_dir),
        }
        payload_path = douyin_dir / "douyin_payload.json"
        title_path = douyin_dir / "title.txt"
        caption_path = douyin_dir / "caption.txt"
        notes_path = douyin_dir / "publish_notes.txt"
        payload_path.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")
        title_path.write_text(title + "\n", encoding="utf-8")
        caption_path.write_text(caption + "\n", encoding="utf-8")
        notes_path.write_text(notes + "\n", encoding="utf-8")
        return {
            "douyin_payload": payload_path,
            "douyin_title": title_path,
            "douyin_caption": caption_path,
            "douyin_notes": notes_path,
        }

    def initialize_login_session(self) -> dict[str, Path | str]:
        if sync_playwright is None:
            raise RuntimeError(
                "Playwright is not installed. Run `pip install playwright` and `playwright install chromium`."
            )
        profile_dir = self._profile_dir()
        profile_dir.mkdir(parents=True, exist_ok=True)
        with sync_playwright() as playwright:
            browser = playwright.chromium.launch_persistent_context(
                user_data_dir=str(profile_dir),
                headless=self.settings.douyin.headless,
                channel=self.settings.douyin.channel or None,
                executable_path=self.settings.douyin.executable_path or None,
            )
            try:
                page = browser.pages[0] if browser.pages else browser.new_page()
                page.goto(
                    self.settings.douyin.publish_url,
                    wait_until="domcontentloaded",
                    timeout=max(self.settings.douyin.wait_timeout_ms, 30000),
                )
                print("Browser launched for Douyin login session initialization.")
                print(f"Profile dir: {profile_dir}")
                print("Log in to your Douyin creator account in the opened browser window.")
                print("Open the image-text publish page and keep this profile for future automation.")
                page.wait_for_timeout(180000)
            finally:
                browser.close()
        return {"profile_dir": profile_dir, "current_url": self.settings.douyin.publish_url}

    def publish_run(self, run_dir: Path) -> dict[str, Path]:
        if not self.settings.douyin.enabled:
            raise RuntimeError("Douyin publishing is disabled. Set DOUYIN_ENABLED=1 first.")
        if sync_playwright is None:
            raise RuntimeError(
                "Playwright is not installed. Run `pip install playwright` and `playwright install chromium`."
            )

        prepared = self.prepare_run(run_dir)
        payload_path = Path(prepared["douyin_payload"])
        payload = self._load_json(payload_path)
        image_paths = [Path(item) for item in payload.get("image_paths", []) if Path(item).exists()]
        if not image_paths:
            raise FileNotFoundError("Douyin publish package contains no available images.")

        profile_dir = self._profile_dir()
        profile_dir.mkdir(parents=True, exist_ok=True)
        notes: list[str] = []
        publish_dir = run_dir / self.settings.review.publish_dirname / "douyin"
        publish_dir.mkdir(parents=True, exist_ok=True)
        result_path = publish_dir / "douyin_publish_result.json"

        with sync_playwright() as playwright:
            browser = playwright.chromium.launch_persistent_context(
                user_data_dir=str(profile_dir),
                headless=self.settings.douyin.headless,
                channel=self.settings.douyin.channel or None,
                executable_path=self.settings.douyin.executable_path or None,
            )
            page = None
            try:
                page = browser.pages[0] if browser.pages else browser.new_page()
                page.goto(
                    self.settings.douyin.publish_url,
                    wait_until="domcontentloaded",
                    timeout=max(self.settings.douyin.wait_timeout_ms, 30000),
                )
                page.wait_for_timeout(1800)
                notes.append(f"Opened publish page: {page.url}")
                self._upload_images(page, image_paths, notes)
                self._fill_caption(page, str(payload.get("caption", "")).strip(), notes)
                page.wait_for_timeout(1200)
                self._click_publish(page, notes)
                success_state = self._wait_for_publish_success(page, notes)
                result_payload = {
                    "status": "submitted" if success_state else "submitted_unknown",
                    "published_at": self._now(),
                    "external_url": page.url,
                    "caption": str(payload.get("caption", "")).strip(),
                    "title": str(payload.get("title", "")).strip(),
                    "image_count": len(image_paths),
                    "notes": notes,
                    "success_state": success_state,
                }
                result_path.write_text(json.dumps(result_payload, ensure_ascii=False, indent=2), encoding="utf-8")
                self._append_history(result_payload)
            except Exception as exc:
                if page is None:
                    raise RuntimeError(f"Douyin publish failed before browser page init: {exc}") from exc
                debug_dir = self._capture_debug_artifacts(page, extra_payload={"notes": notes, "payload": payload})
                raise RuntimeError(f"Douyin publish failed: {exc}. Debug files saved to: {debug_dir}") from exc
            finally:
                browser.close()

        return {
            **prepared,
            "douyin_publish_result": result_path,
            "douyin_publish_history": self.history_path,
        }

    def _upload_images(self, page, image_paths: list[Path], notes: list[str]) -> None:
        selector = self._first_visible_selector(
            page,
            self.settings.douyin.selectors.get("image_upload", []) or self.DEFAULT_UPLOAD_SELECTORS,
            timeout=max(self.settings.douyin.wait_timeout_ms, 20000),
        )
        if not selector:
            raise RuntimeError("Douyin image upload input was not found.")
        chosen_index = page.locator(selector).evaluate_all(
            "els => { for (let i = 0; i < els.length; i++) { const accept = (els[i].getAttribute('accept') || '').toLowerCase(); if (accept.includes('image')) return i; } return 0; }"
        )
        page.locator(selector).nth(int(chosen_index)).set_input_files([str(path) for path in image_paths])
        page.wait_for_timeout(5000)
        notes.append(f"Uploaded {len(image_paths)} image(s) via selector: {selector} index={chosen_index}")

    def _fill_caption(self, page, caption: str, notes: list[str]) -> None:
        selector = self._first_visible_selector(
            page,
            self.settings.douyin.selectors.get("caption_input", []) or self.DEFAULT_CAPTION_SELECTORS,
            timeout=max(self.settings.douyin.wait_timeout_ms, 20000),
        )
        if not selector:
            raise RuntimeError("Douyin caption editor was not found.")
        locator = page.locator(selector).first
        tag_name = locator.evaluate("node => node.tagName.toLowerCase()")
        locator.click()
        if tag_name == "textarea":
            locator.fill(caption)
        else:
            page.keyboard.press("Control+A")
            page.keyboard.press("Backspace")
            page.keyboard.type(caption, delay=15)
        notes.append(f"Filled caption via selector: {selector}")

    def _click_publish(self, page, notes: list[str]) -> None:
        selector = self._first_visible_selector(
            page,
            self.settings.douyin.selectors.get("publish_button", []) or self.DEFAULT_PUBLISH_SELECTORS,
            timeout=max(self.settings.douyin.wait_timeout_ms, 20000),
        )
        if not selector:
            raise RuntimeError("Douyin publish button was not found.")
        page.locator(selector).first.click()
        notes.append(f"Clicked publish button via selector: {selector}")

    def _wait_for_publish_success(self, page, notes: list[str]) -> bool:
        selector = self._first_visible_selector(
            page,
            self.settings.douyin.selectors.get("success_indicator", []) or self.DEFAULT_SUCCESS_SELECTORS,
            timeout=max(self.settings.douyin.wait_timeout_ms, 15000),
        )
        if selector:
            notes.append(f"Detected Douyin success indicator: {selector}")
            return True
        notes.append("No explicit Douyin success indicator was detected before timeout.")
        return False

    def _resolve_image_assets(self, publish_dir: Path) -> tuple[Path, list[Path]]:
        publish_images_dir = publish_dir / "images"
        run_images_dir = publish_dir.parent / "images"
        candidates: list[Path] = []
        for root in (publish_images_dir, run_images_dir):
            cover = root / "cover.png"
            if cover.exists() and cover not in candidates:
                candidates.append(cover)
            for item in sorted(root.glob("infographic_*.png")):
                if item.exists() and item not in candidates:
                    candidates.append(item)
        if not candidates:
            raise FileNotFoundError(f"No image assets found under: {publish_images_dir} or {run_images_dir}")
        selected = candidates[: max(1, int(self.settings.douyin.max_images))]
        return selected[0], selected

    def _build_caption(self, *, title: str, summary: str, article: str) -> str:
        blocks = [self._clip_title(title)]
        summary_line = self._clean_line(summary)
        if summary_line:
            blocks.append(summary_line)
        blocks.extend(self._extract_key_lines(article, limit=3))
        body = "\n\n".join(item for item in blocks if item)
        hashtags = " ".join(self._build_hashtags(title=title, summary=summary, article=article))
        if hashtags:
            body = f"{body}\n\n{hashtags}".strip()
        return body[: max(60, int(self.settings.douyin.caption_max_length))].rstrip()

    def _build_hashtags(self, *, title: str, summary: str, article: str) -> list[str]:
        base = ["#??", "#????"]
        text = f"{title} {summary} {article}"
        if any(token in text for token in ("AI", "????", "??", "??", "??")):
            base.append("#AI")
        if any(token in text for token in ("???", "??")):
            base.append("#???")
        if any(token in text for token in ("???", "??", "??")):
            base.append("#???")
        result: list[str] = []
        seen: set[str] = set()
        for item in base:
            cleaned = item.strip()
            if cleaned and cleaned not in seen:
                seen.add(cleaned)
                result.append(cleaned)
        return result[:5]

    def _build_notes(self, *, title: str, caption: str, hashtags: list[str]) -> str:
        return (
            "??????: ???????\n"
            f"????: {self.settings.douyin.niche}\n"
            f"??????: {self.settings.douyin.daily_post_target} ?\n"
            f"??: {title}\n"
            f"??: {' '.join(hashtags)}\n"
            "??: ???????????????????????\n"
            f"????:\n{caption}"
        )

    def _extract_key_lines(self, article: str, limit: int = 3) -> list[str]:
        paragraphs = [self._clean_line(item) for item in re.split(r"\n{2,}", article or "")]
        result: list[str] = []
        for item in paragraphs:
            if not item:
                continue
            if item.startswith("#"):
                item = item.lstrip("#").strip()
            if len(item) < 18:
                continue
            result.append(item[:58].rstrip("?,?;?:?.!???"))
            if len(result) >= limit:
                break
        return result

    def _first_visible_selector(self, page, selectors: list[str], *, timeout: int) -> str | None:
        for selector in selectors:
            if not str(selector).strip():
                continue
            try:
                page.locator(selector).first.wait_for(state="visible", timeout=timeout)
                return selector
            except PlaywrightTimeoutError:
                continue
            except Exception:
                continue
        return None

    def _capture_debug_artifacts(self, page, extra_payload: dict[str, Any] | None = None) -> Path:
        timestamp = datetime.now().strftime("%Y%m%d-%H%M%S")
        debug_dir = self.settings.output_dir / "douyin_publish_debug" / timestamp
        debug_dir.mkdir(parents=True, exist_ok=True)
        try:
            page.screenshot(path=str(debug_dir / "douyin_page.png"), full_page=True)
        except Exception as exc:
            self.logger.warning("Failed to save Douyin debug screenshot: %s", exc)
        try:
            (debug_dir / "douyin_page.html").write_text(page.content(), encoding="utf-8")
        except Exception as exc:
            self.logger.warning("Failed to save Douyin debug html: %s", exc)
        try:
            (debug_dir / "current_url.txt").write_text(page.url, encoding="utf-8")
        except Exception as exc:
            self.logger.warning("Failed to save Douyin debug url: %s", exc)
        if extra_payload is not None:
            try:
                (debug_dir / "publish_context.json").write_text(
                    json.dumps(extra_payload, ensure_ascii=False, indent=2),
                    encoding="utf-8",
                )
            except Exception as exc:
                self.logger.warning("Failed to save Douyin debug context: %s", exc)
        return debug_dir

    def _append_history(self, item: dict[str, Any]) -> None:
        history: list[dict[str, Any]] = []
        if self.history_path.exists():
            try:
                payload = json.loads(self.history_path.read_text(encoding="utf-8"))
                if isinstance(payload, list):
                    history = [row for row in payload if isinstance(row, dict)]
            except Exception:
                history = []
        history.append(item)
        self.history_path.write_text(json.dumps(history, ensure_ascii=False, indent=2), encoding="utf-8")

    def _clip_title(self, text: str) -> str:
        return self._clean_line(text)[: max(8, int(self.settings.douyin.title_max_length))].rstrip()

    def _clean_line(self, text: str) -> str:
        value = re.sub(r"\s+", " ", str(text or "")).strip()
        return re.sub(r"^[#]+", "", value).strip()

    def _profile_dir(self) -> Path:
        profile = Path(self.settings.douyin.user_data_dir)
        if profile.is_absolute():
            return profile
        return (self.settings.project_root / profile).resolve()

    def _load_json(self, path: Path) -> dict[str, Any]:
        if not path.exists():
            return {}
        payload = json.loads(path.read_text(encoding="utf-8"))
        return payload if isinstance(payload, dict) else {}

    def _read_text(self, path: Path) -> str:
        if not path.exists():
            return ""
        return path.read_text(encoding="utf-8")

    def _now(self) -> str:
        return datetime.now().isoformat(timespec="seconds")
