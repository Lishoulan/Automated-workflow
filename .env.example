# ============================ API配置（支持 OpenAI 兼容服务，如 DeepSeek） ============================
# DeepSeek 配置示例（推荐）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
OPENAI_TEMPERATURE=0.7

TOUTIAO_ACCOUNT=default

IMAGE_BACKEND=image2
IMAGE_API_MODE=images
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=gpt-image-2
IMAGE_MAX_ASSETS=2
IMAGE_COVER_SIZE=1536x1024
IMAGE_INFOGRAPHIC_SIZE=1024x1536
IMAGE_QUALITY=high
IMAGE_STYLE=vivid
IMAGE_BACKGROUND=opaque
IMAGE_REQUEST_TIMEOUT_SECONDS=180
IMAGE_FALLBACK_TO_RENDERER=1

# Example for an OpenAI-compatible relay:
# IMAGE_API_MODE=auto
# IMAGE_API_KEY=your_key
# IMAGE_BASE_URL=https://your-relay-endpoint/v1
# IMAGE_MODEL=gpt-image-2

ARTICLE_WORD_TARGET=1200
MAX_INPUT_CHARS=16000
BRAND_NAME=Your Brand
INDUSTRY_FOCUS=New energy, robotics, intelligent equipment, energy storage
# Set to all if one scheduled workflow should handle every enabled platform together.
TARGET_PLATFORM=all
TARGET_AUDIENCE=Readers interested in tech industry analysis
DEFAULT_STYLE=deep_industry_analysis
TITLE_COUNT=20
RECOMMENDED_TITLE_COUNT=3
CACHE_SIMILARITY_THRESHOLD=0.82
LOG_LEVEL=INFO

# ============================ 合规配置（2026 平台规则适配） ============================
# 自动发布已关闭，改为"草稿+人工审核"模式，符合微信/头条反自动化创作规范
TOUTIAO_PUBLISH_ENABLED=1
TOUTIAO_AUTO_PUBLISH=0
TOUTIAO_MAX_DAILY_TOPIC_ATTEMPTS=3
TOUTIAO_MAX_DAILY_POSTS=2
TOUTIAO_AIGC_DECLARATION_ENABLED=1
TOUTIAO_PUBLISH_PLATFORM=toutiao
TOUTIAO_PUBLISH_BASE_URL=https://mp.toutiao.com/
TOUTIAO_PUBLISH_URL=https://mp.toutiao.com/profile_v4/graphic/publish
TOUTIAO_BROWSER_PROFILE_DIR=.runtime/toutiao_profile
TOUTIAO_PUBLISH_CHANNEL=msedge
TOUTIAO_BROWSER_EXECUTABLE=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
TOUTIAO_PUBLISH_HEADLESS=0
TOUTIAO_PUBLISH_TIMEOUT_MS=15000
TOUTIAO_PUBLISH_HISTORY_FILE=publish_history.json
TOUTIAO_ALLOW_DUPLICATE_TOPICS=0
TOUTIAO_TITLE_MAX_LENGTH=30
TOUTIAO_PUBLISH_COVER_MODE=single

# 微头条高频化（2026-08-27）：每日微头条目标条数（含图文伴生 1 条），
# 超出部分由「独立微头条选题+写作」补齐（2-3 条/日涨粉效果最佳）。
TOUTIAO_WEITOUTIAO_ENABLED=1
TOUTIAO_WEITOUTIAO_PUBLISH_URL=https://mp.toutiao.com/profile_v4/weitoutiao/publish
TOUTIAO_WEITOUTIAO_DAILY_TARGET=3
TOUTIAO_WEITOUTIAO_STANDALONE_ENABLED=1
# Use a deterministic, evidence-only short post when the model gateway returns a transient 5xx/timeout.
TOUTIAO_WEITOUTIAO_LOCAL_FALLBACK_ENABLED=1
# 独立微头条人设，按序轮换：hot_comment / warm / sanhuo / shoulan
TOUTIAO_WEITOUTIAO_PERSONAS=hot_comment,warm,sanhuo

# 微信自动发布已关闭，仅创建草稿，人工审核后发布
WECHAT_ENABLED=0
WECHAT_AUTO_PUBLISH=0
WECHAT_OFFICIAL_PUBLISH_ENABLED=0
WECHAT_EDITOR_135_ENABLED=0
WECHAT_AIGC_DECLARATION_ENABLED=1
# Required when WECHAT_ENABLED=1.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_ACCOUNT_NAME=
WECHAT_AUTHOR_NAME=手蓝
WECHAT_BASE_URL=https://mp.weixin.qq.com/
WECHAT_API_BASE_URL=https://api.weixin.qq.com
WECHAT_TITLE_MAX_LENGTH=64
WECHAT_DIGEST_MAX_LENGTH=120
WECHAT_HISTORY_FILENAME=wechat_publish_history.json
WECHAT_COVER_STRATEGY=first_inline
WECHAT_LAYOUT_BACKEND=builtin
WECHAT_MD2WECHAT_ENABLED=0

# ============================ Serv00 代理配置（解决微信公众号 IP 白名单问题） ============================
# 启用后，微信 API 请求将通过 Serv00 固定 IP 代理转发，不再受本地 IP 变化影响
# 部署步骤：
#   1. 注册 Serv00 免费账号（https://www.serv00.com）
#   2. SSH 上传 scripts/serv00_wechat_proxy.py 到 Serv00
#   3. 在 Serv00 上运行: python3 wechat_proxy.py start
#   4. 将 Serv00 公网 IP 加入微信公众号白名单
#   5. 配置以下环境变量
WECHAT_SERV00_PROXY_ENABLED=0
# Serv00 代理地址（格式: https://yourname.serv00.net:8765）
WECHAT_SERV00_PROXY_URL=
# 代理密钥（必须与 Serv00 上 wechat_proxy.py 中的 WECHAT_PROXY_SECRET 一致）
WECHAT_SERV00_PROXY_SECRET=

MD2WECHAT_API_KEY=
MD2WECHAT_BASE_URL=https://www.md2wechat.com/api/v1
MD2WECHAT_THEME=default
MD2WECHAT_FONT_SIZE=medium
MD2WECHAT_CONVERT_VERSION=v1
MD2WECHAT_CLI_PATH=
MD2WECHAT_FALLBACK_TO_BUILTIN=1

TOUTIAO_FAST_MODE=1
TOUTIAO_EXPERT_COUNCIL_ENABLED=1
TOUTIAO_ENHANCED_INSIGHTS_USE_DATA_MINING=1
# 成稿质量审核专家团：润色后自动审校，必要时最多自动返工1次
TOUTIAO_QUALITY_REVIEW_COUNCIL_ENABLED=1
TOUTIAO_QUALITY_REVIEW_AUTO_REVISE=1
TOUTIAO_QUALITY_REVIEW_MAX_AUTO_REVISIONS=1
TOUTIAO_QUALITY_REVIEW_MIN_SCORE=78
TOUTIAO_QUALITY_REVIEW_MIN_DIMENSION_SCORE=65
# 可按需用逗号覆盖默认角色列表
# TOUTIAO_QUALITY_REVIEW_COUNCIL_ROLES=quality-fact-checker,quality-logic-auditor,quality-structure-editor,quality-originality-auditor,quality-compliance-editor
TOUTIAO_SKIP_IMAGE_GENERATION=1
TOUTIAO_SKIP_REVIEW_AGENT=1
TOUTIAO_SKIP_PUBLISH_REVIEW=1
TOUTIAO_REVIEW_MIN_OVERALL_SCORE=72
TOUTIAO_REVIEW_MAX_AI_RISK=45
TOUTIAO_AUTO_PUBLISH_MIN_OVERALL_SCORE=80
TOUTIAO_AUTO_PUBLISH_MAX_AI_RISK=40
TOUTIAO_AUTO_PUBLISH_MIN_VALIDATION_SCORE=80
TOUTIAO_AUTO_PUBLISH_MIN_READINESS_SCORE=70

# ============================ 收益归因与选题冷却 ============================
REVENUE_OPTIMIZATION_ENABLED=1
REVENUE_OPTIMIZATION_LOOKBACK_DAYS=30
REVENUE_OPTIMIZATION_MIN_SAMPLES=10
REVENUE_WEAK_RPM_THRESHOLD=0
REVENUE_WEAK_READ_RATE_THRESHOLD=3
REVENUE_COOLDOWN_WEAK_RATIO=0.5
REVENUE_STOP_WEAK_RATIO=0.8
REVENUE_COOLDOWN_PENALTY=12

# ============================ 多账号防关联配置 ============================
# 代理IP（留空则不使用代理）
TOUTIAO_PROXY_SERVER=
# 同一账号两次登录之间的最小间隔秒数
ACCOUNT_LOGIN_INTERVAL_SECONDS=300
# 同一主机上不同账号切换之间的最小间隔秒数
ACCOUNT_SWITCH_INTERVAL_SECONDS=60

# ============================ 紧急通知 ============================
# 方糖（Server酱）SendKey；只放在本地 .env 或 GitHub Actions Secret 中
# SERVERCHAN_SENDKEY=
# 日常成功/失败/人工审核事件只写入日报队列，有事件时 22:00 统一发送一条汇总。
# 空日报不发送；免费版每天最多 5 条，并为日报预留 1 条额度。
NOTIFY_DAILY_LIMIT=5
