.env
# ⚠️ 备份文件带时间戳后缀（.env.bak-20260915-0945 / config.yaml.bak-20260904），
# 不匹配下面的 *.bak，必须显式忽略，否则 git add -A 会把里面的 API key 推到 GitHub。
.env.bak*
.env.*.bak*
*.bak-*
.env.local
.venv/
.runtime/
# 跨通道发布状态的本地副本：权威版本在 publish-state 分支上（云端写入、本地读）。
# 工作区里的这份是运行时产物，不入 main，避免本地开发时制造改动噪音。
state/
# 我（小蓝的助手）下载云端 run 产物的缓存目录，纯本地排查用，不入库。
.cloud-artifacts/
# 项目记忆/日志：内容是本地路径、账号收益等，且属于"助手的工作记录"，
# 不随代码分发。注意只忽略 memory，不忽略 .workbuddy/skills（项目级技能是要共享的）。
.workbuddy/memory/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# 数据库文件
*.db
*.db-journal
*.sqlite
*.sqlite3

logs/
cache/
output/
/images/
.tmp_publish_regen/

.idea/
.vscode/
.trae/
Thumbs.db
Desktop.ini

catboost_info/
*.egg-info/
dist/
build/
*.egg

guard-smoke-*/
config/guard-*/

# 根目录的 SKILL.md（非 .qoder/skills/ 下的）
/SKILL.md
zettaranc-skill-main/

# 临时调试文件
_temp_*
_fix_*
temp_*
test_stderr*
test_stdout*
test_err*
test_out*
pip_install_log*
wechat_patch_*

# 一次性调试/修复/检查脚本
_debug_*.py
fix_*.py
cleanup_*.py
inspect_*.py
verify_*.py
analyze_*.py
check_articles*.py
check_syntax*.py
check_file*.py
check_remaining*.py
check_final*.py
read_files*.py
optimize_*.py
_refactor_*.py

# 备份文件
*.bak
*.broken_*
*.gbkdecoded.*

# Codex 引用文件
.codex_*

# 敏感凭据文件（cookie/profile 导出）
cookies_dl.json
cookies_*.json
*_cookies.json
cookie_dump*.json
browser_profiles_seed.tar.gz

# 运行日志（根目录散落的调试日志）
*.log
run_daily*.bat
keep_alive*.log
auto_login*_output*.log

# 一次性/临时测试脚本与数据
test_browser*.py
_input_single/
input_single/
scripts/_*_tmp.py
scripts/_check_*_tmp.py
scripts/_gh_*_tmp.py

# 误存的 pip 输出文件（如版本号命名的日志）
/[0-9]*.[0-9]*.[0-9]*

# 工作区盘点技能生成的报告/台账（带日期，属一次性产物）
文件整理方案_*.html
文件整理台账_*.json

# 工作区盘点技能创建的归档区（含一键回滚脚本）
_archive_*/
