# ============================ API配置（支持 OpenAI 兼容服务，如 DeepSeek） ============================
# DeepSeek 配置示例（推荐）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
OPENAI_TEMPERATURE=0.7

TOUTIAO_ACCOUNT=default

IMAGE_BACKEND=renderer
IMAGE_API_MODE=images
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=gpt-image-2
IMAGE_MAX_ASSETS=2
IMAGE_COVER_SIZE=1536x1024
IMAGE_INFOGRAPHIC_SIZE=1024x1536
IMAGE_QUALITY=high
IMAGE_STYLE=vivid
IMAGE_BACKGROUND=opaque
IMAGE_FALLBACK_TO_RENDERER=1

# Example for an OpenAI-compatible relay:
# IMAGE_BACKEND=image2
# IMAGE_API_MODE=auto
# IMAGE_API_KEY=your_key
# IMAGE_BASE_URL=https://your-relay-endpoint/v1
# IMAGE_MODEL=gpt-image-2

ARTICLE_WORD_TARGET=1200
MAX_INPUT_CHARS=16000
BRAND_NAME=Your Brand
INDUSTRY_FOCUS=New energy, robotics, intelligent equipment, energy storage
# Set to all if one scheduled workflow should handle every enabled platform together.
TARGET_PLATFORM=all
TARGET_AUDIENCE=Readers interested in tech industry analysis
DEFAULT_STYLE=deep_industry_analysis
TITLE_COUNT=20
RECOMMENDED_TITLE_COUNT=3
CACHE_SIMILARITY_THRESHOLD=0.82
LOG_LEVEL=INFO

# ============================ 合规配置（2026 平台规则适配） ============================
# 自动发布已关闭，改为"草稿+人工审核"模式，符合微信/头条反自动化创作规范
TOUTIAO_PUBLISH_ENABLED=1
TOUTIAO_AUTO_PUBLISH=0
TOUTIAO_MAX_DAILY_TOPIC_ATTEMPTS=3
TOUTIAO_MAX_DAILY_POSTS=2
TOUTIAO_AIGC_DECLARATION_ENABLED=1
TOUTIAO_PUBLISH_PLATFORM=toutiao
TOUTIAO_PUBLISH_BASE_URL=https://mp.toutiao.com/
TOUTIAO_PUBLISH_URL=https://mp.toutiao.com/profile_v4/graphic/publish
TOUTIAO_BROWSER_PROFILE_DIR=.runtime/toutiao_profile
TOUTIAO_PUBLISH_CHANNEL=msedge
TOUTIAO_BROWSER_EXECUTABLE=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
TOUTIAO_PUBLISH_HEADLESS=0
TOUTIAO_PUBLISH_TIMEOUT_MS=15000
TOUTIAO_PUBLISH_HISTORY_FILE=publish_history.json
TOUTIAO_ALLOW_DUPLICATE_TOPICS=0
TOUTIAO_TITLE_MAX_LENGTH=30
TOUTIAO_PUBLISH_COVER_MODE=single

# 微信自动发布已关闭，仅创建草稿，人工审核后发布
WECHAT_ENABLED=0
WECHAT_AUTO_PUBLISH=0
WECHAT_AIGC_DECLARATION_ENABLED=1
# Required when WECHAT_ENABLED=1.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_ACCOUNT_NAME=
WECHAT_AUTHOR_NAME=手蓝
WECHAT_BASE_URL=https://mp.weixin.qq.com/
WECHAT_API_BASE_URL=https://api.weixin.qq.com
WECHAT_TITLE_MAX_LENGTH=64
WECHAT_DIGEST_MAX_LENGTH=120
WECHAT_HISTORY_FILENAME=wechat_publish_history.json
WECHAT_COVER_STRATEGY=first_inline
WECHAT_LAYOUT_BACKEND=builtin
WECHAT_MD2WECHAT_ENABLED=0
DOUYIN_ENABLED=0
DOUYIN_AUTO_PUBLISH=0
DOUYIN_AIGC_DECLARATION_ENABLED=1
DOUYIN_MAX_DAILY_POSTS=3
DOUYIN_NICHE=??
DOUYIN_PUBLISH_MODE=browser
DOUYIN_DAILY_POST_TARGET=10
DOUYIN_BASE_URL=https://creator.douyin.com/
DOUYIN_PUBLISH_URL=https://creator.douyin.com/creator-micro/content/upload
DOUYIN_BROWSER_PROFILE_DIR=.runtime/douyin_profile
DOUYIN_PUBLISH_CHANNEL=msedge
DOUYIN_BROWSER_EXECUTABLE=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
DOUYIN_PUBLISH_HEADLESS=0
DOUYIN_PUBLISH_TIMEOUT_MS=20000
DOUYIN_PUBLISH_HISTORY_FILE=douyin_publish_history.json
DOUYIN_TITLE_MAX_LENGTH=30
DOUYIN_CAPTION_MAX_LENGTH=220
DOUYIN_MAX_IMAGES=3

MD2WECHAT_API_KEY=
MD2WECHAT_BASE_URL=https://www.md2wechat.com/api/v1
MD2WECHAT_THEME=default
MD2WECHAT_FONT_SIZE=medium
MD2WECHAT_CONVERT_VERSION=v1
MD2WECHAT_CLI_PATH=
MD2WECHAT_FALLBACK_TO_BUILTIN=1

TOUTIAO_FAST_MODE=1
TOUTIAO_SKIP_IMAGE_GENERATION=1
TOUTIAO_SKIP_REVIEW_AGENT=1
TOUTIAO_SKIP_PUBLISH_REVIEW=1
TOUTIAO_REVIEW_MIN_OVERALL_SCORE=72
TOUTIAO_REVIEW_MAX_AI_RISK=45
TOUTIAO_AUTO_PUBLISH_MIN_OVERALL_SCORE=80
TOUTIAO_AUTO_PUBLISH_MAX_AI_RISK=40
TOUTIAO_AUTO_PUBLISH_MIN_VALIDATION_SCORE=80
TOUTIAO_AUTO_PUBLISH_MIN_READINESS_SCORE=70

# ============================ 多账号防关联配置 ============================
# 代理IP（留空则不使用代理）
TOUTIAO_PROXY_SERVER=
# 同一账号两次登录之间的最小间隔秒数
ACCOUNT_LOGIN_INTERVAL_SECONDS=300
# 同一主机上不同账号切换之间的最小间隔秒数
ACCOUNT_SWITCH_INTERVAL_SECONDS=60
